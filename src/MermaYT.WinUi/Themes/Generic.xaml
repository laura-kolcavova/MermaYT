<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MermaYT.WinUi.Controls">

    <Style x:Key="StyleIconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style TargetType="controls:MusleIcon">
        <Setter Property="Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:MusleIcon">
                    <Image
                        x:Name="MusleImage"
                        Width="64"
                        Height="64"
                        VerticalAlignment="Center"
                        Source="ms-appx:///Assets/musle.svg" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:PageHeader">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:PageHeader">
                    <Grid x:Name="PageHeader" Padding="24,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="8">
                            <TextBlock
                                x:Name="HeaderTitle"
                                Style="{StaticResource TitleTextBlockStyle}"
                                Text="{TemplateBinding Title}" />

                            <TextBlock
                                x:Name="HeaderSubtitle"
                                FontSize="14"
                                FontWeight="Normal"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{TemplateBinding Subtitle}"
                                Visibility="{TemplateBinding SubtitleVisibility}" />
                        </StackPanel>

                        <controls:MusleIcon Grid.Column="1" VerticalAlignment="Center" />

                        <!--<Image
                            Grid.Column="1"
                            Width="64"
                            Height="64"
                            VerticalAlignment="Center"
                            Source="ms-appx:///Assets/musle.svg" />-->
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:DownloadListItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:DownloadListItem">
                    <Border
                        Padding="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid ColumnSpacing="48">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Grid.Column="0"
                                    Width="80"
                                    Height="80"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="4">
                                    <Border.Clip>
                                        <RectangleGeometry Rect="0,0,80,80" />
                                    </Border.Clip>

                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <FontIcon
                                            x:Name="AudioFormatIcon"
                                            FontSize="32"
                                            Glyph="{StaticResource GlyphMusic}"
                                            Visibility="Collapsed" />
                                        <FontIcon
                                            x:Name="VideoFormatIcon"
                                            FontSize="32"
                                            Glyph="{StaticResource GlyphMovie}"
                                            Visibility="Collapsed" />
                                    </Grid>
                                </Border>

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="8">
                                    <Grid VerticalAlignment="Center" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{TemplateBinding Title}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />

                                        <Border
                                            Grid.Column="1"
                                            Padding="6,2"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="4">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                    Text="{TemplateBinding OutputFormatText}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ProgressBar
                                            x:Name="DownloadProgressBar"
                                            Grid.Column="0"
                                            Maximum="100"
                                            Value="{TemplateBinding Progress}" />

                                        <TextBlock
                                            x:Name="DownloadProgressText"
                                            Grid.Column="1"
                                            LineHeight="22"
                                            Text="{TemplateBinding ProgressText}" />
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            x:Name="DownloadStatusText"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{TemplateBinding DownloadStateText}" />

                                        <TextBlock
                                            x:Name="StatusSeparatorText"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="·" />

                                        <StackPanel
                                            x:Name="BytesStatusStackPanel"
                                            Orientation="Horizontal"
                                            Spacing="4">
                                            <TextBlock
                                                x:Name="DownloadedBytesText"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{TemplateBinding DownloadedBytesText}" />

                                            <TextBlock
                                                x:Name="BytesSeparatorText"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="of" />

                                            <TextBlock
                                                x:Name="TotalBytesText"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{TemplateBinding TotalBytesText}" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button x:Name="OpenDestinationFolderButton" Style="{StaticResource StyleIconButton}">
                                    <FontIcon FontSize="14" Glyph="{StaticResource GlyphFolderHorizontal}" />
                                </Button>

                                <Button x:Name="RemoveButton" Style="{StaticResource StyleIconButton}">
                                    <FontIcon FontSize="14" Glyph="{StaticResource GlyphClear}" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="DownloadStates">
                                <VisualState x:Name="Processing">
                                    <VisualState.Setters>
                                        <Setter Target="DownloadProgressBar.IsIndeterminate" Value="True" />
                                        <!--<Setter Target="DownloadProgressText.Opacity" Value="0" />-->
                                        <Setter Target="StatusSeparatorText.Visibility" Value="Collapsed" />
                                        <Setter Target="BytesStatusStackPanel.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="Downloading" />

                                <VisualState x:Name="Converting">
                                    <VisualState.Setters>
                                        <Setter Target="DownloadProgressBar.IsIndeterminate" Value="True" />
                                        <!--<Setter Target="DownloadProgressText.Opacity" Value="0" />-->
                                        <Setter Target="DownloadedBytesText.Visibility" Value="Collapsed" />
                                        <Setter Target="BytesSeparatorText.Visibility" Value="Collapsed" />
                                        <Setter Target="DownloadProgressBar.IsIndeterminate" Value="True" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="Completed">
                                    <VisualState.Setters>
                                        <Setter Target="DownloadedBytesText.Visibility" Value="Collapsed" />
                                        <Setter Target="BytesSeparatorText.Visibility" Value="Collapsed" />
                                        <Setter Target="DownloadStatusText.Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="Error">
                                    <VisualState.Setters>
                                        <Setter Target="StatusSeparatorText.Visibility" Value="Collapsed" />
                                        <Setter Target="BytesStatusStackPanel.Visibility" Value="Collapsed" />
                                        <Setter Target="DownloadStatusText.Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="OutputFormatStates">
                                <VisualState x:Name="MP3">
                                    <VisualState.Setters>
                                        <Setter Target="AudioFormatIcon.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="MP4">
                                    <VisualState.Setters>
                                        <Setter Target="VideoFormatIcon.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
