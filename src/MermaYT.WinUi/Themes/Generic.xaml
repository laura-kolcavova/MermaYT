<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MermaYT.WinUi.Controls">

    <Style x:Key="StyleIconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style TargetType="controls:ShellIconDark">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:ShellIconDark">
                    <Canvas Width="960.5" Height="960.5">

                        <!--  bg_60  -->
                        <Path Fill="{TemplateBinding FillBrush}" Opacity="0.6">
                            <Path.Data>
                                <EllipseGeometry
                                    Center="314.81,337.57"
                                    RadiusX="208.24"
                                    RadiusY="208.24" />
                            </Path.Data>
                        </Path>

                        <!--  bg_60 overlay  -->
                        <Path Fill="#222222" Opacity="0.3">
                            <Path.Data>
                                <EllipseGeometry
                                    Center="314.81,337.57"
                                    RadiusX="208.24"
                                    RadiusY="208.24" />
                            </Path.Data>
                        </Path>


                        <!--  bg_100_big  -->
                        <Path Fill="{TemplateBinding FillBrush}">
                            <Path.Data>
                                <EllipseGeometry
                                    Center="626.00,582.40"
                                    RadiusX="311.03"
                                    RadiusY="311.03" />
                            </Path.Data>
                        </Path>

                        <!--  bg_100_big overlay  -->
                        <Path Fill="#222222" Opacity="0.3">
                            <Path.Data>
                                <EllipseGeometry
                                    Center="626.00,582.40"
                                    RadiusX="311.03"
                                    RadiusY="311.03" />
                            </Path.Data>
                        </Path>

                        <!--  bg_100_small  -->
                        <Path Fill="{TemplateBinding FillBrush}">
                            <Path.Data>
                                <EllipseGeometry
                                    Center="207.99,783.50"
                                    RadiusX="92.74"
                                    RadiusY="92.74" />
                            </Path.Data>
                        </Path>

                        <!--  bg_100_small overlay  -->
                        <Path Fill="#222222" Opacity="0.3">
                            <Path.Data>
                                <EllipseGeometry
                                    Center="207.99,783.50"
                                    RadiusX="92.74"
                                    RadiusY="92.74" />
                            </Path.Data>
                        </Path>

                        <!--  shell underlay  -->
                        <Path
                            Data="{StaticResource ShellIconPath}"
                            Fill="{ThemeResource TextFillColorPrimaryBrush}"
                            RenderTransformOrigin="0,0">
                            <Path.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="4.39663" ScaleY="4.39663" />
                                    <TranslateTransform X="36.41" Y="-94.52" />
                                </TransformGroup>
                            </Path.RenderTransform>
                        </Path>

                        <!--  shell  -->
                        <Path
                            Data="{StaticResource ShellIconPath}"
                            Fill="{TemplateBinding FillBrush}"
                            Opacity="0.2"
                            RenderTransformOrigin="0,0">
                            <Path.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="4.39663" ScaleY="4.39663" />
                                    <TranslateTransform X="36.41" Y="-94.52" />
                                </TransformGroup>
                            </Path.RenderTransform>
                        </Path>

                        <!--  shell overlay  -->
                        <Path
                            Data="{StaticResource ShellIconPath}"
                            Fill="#222222"
                            Opacity="0.3"
                            RenderTransformOrigin="0,0">
                            <Path.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="4.39663" ScaleY="4.39663" />
                                    <TranslateTransform X="36.41" Y="-94.52" />
                                </TransformGroup>
                            </Path.RenderTransform>
                        </Path>
                    </Canvas>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

