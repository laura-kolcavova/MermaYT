<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MermaYT.WinUi.Controls"
    xmlns:converters="using:MermaYT.WinUi.Converters">

    <converters:BytesToFileSizeConverter x:Key="BytesToFileSizeConverter" />
    <converters:DownloadStateToStringConverter x:Key="DownloadStateToStringConverter" />
    <converters:OutputFormatToStringConverter x:Key="OutputFormatToStringConverter" />

    <Style x:Key="StyleIconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style TargetType="controls:PageHeader">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:PageHeader">
                    <Grid
                        x:Name="PageHeader"
                        Grid.Row="0"
                        Padding="24,12,24,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="8">
                            <TextBlock
                                x:Name="HeaderTitle"
                                Style="{StaticResource TitleTextBlockStyle}"
                                Text="{TemplateBinding Title}" />

                            <TextBlock
                                x:Name="HeaderSubtitle"
                                FontSize="14"
                                FontWeight="Normal"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{TemplateBinding Subtitle}"
                                Visibility="{TemplateBinding SubtitleVisibility}" />
                        </StackPanel>

                        <Image
                            Grid.Column="1"
                            Width="64"
                            Height="64"
                            VerticalAlignment="Center"
                            Source="ms-appx:///Assets/Square150x150Logo.scale-200.png" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:DownloadListItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:DownloadListItem">
                    <Border
                        Padding="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid ColumnSpacing="48">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Grid.Column="0"
                                    Width="80"
                                    Height="80"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="4">
                                    <Border.Clip>
                                        <RectangleGeometry Rect="0,0,80,80" />
                                    </Border.Clip>

                                    <Image Source="{Binding Item.ImageUrl, RelativeSource={RelativeSource TemplatedParent}}" Stretch="UniformToFill" />
                                </Border>

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="8">
                                    <StackPanel
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{Binding Item.Title, RelativeSource={RelativeSource TemplatedParent}}"
                                            TextTrimming="CharacterEllipsis" />

                                        <Border
                                            Padding="6,2"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="4">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                    Text="{Binding Item.OutputFormat, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource OutputFormatToStringConverter}}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ProgressBar
                                            x:Name="DownloadProgressBar"
                                            Grid.Column="0"
                                            Maximum="1"
                                            Value="{Binding Item.Progress, RelativeSource={RelativeSource TemplatedParent}}" />

                                        <TextBlock
                                            Grid.Column="1"
                                            LineHeight="22"
                                            Text="0%" />
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{Binding Item.DownloadState, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DownloadStateToStringConverter}}" />

                                        <TextBlock
                                            x:Name="StatusAndBytesStatusSeparator"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="·" />

                                        <TextBlock
                                            x:Name="BytesStatus"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}">
                                            <Run Text="{Binding Item.DownloadedBytes, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BytesToFileSizeConverter}}" />
                                            <Run Text=" of " />
                                            <Run Text="{Binding Item.TotalBytes, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BytesToFileSizeConverter}}" />
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button x:Name="OpenDestinationFolderButton" Style="{StaticResource StyleIconButton}">
                                    <FontIcon FontSize="14" Glyph="{StaticResource GlyphFolderHorizontal}" />
                                </Button>

                                <Button x:Name="PauseButton" Style="{StaticResource StyleIconButton}">
                                    <FontIcon FontSize="14" Glyph="{StaticResource GlyphPause}" />
                                </Button>

                                <Button
                                    x:Name="ResumeButton"
                                    Style="{StaticResource StyleIconButton}"
                                    Visibility="Collapsed">
                                    <FontIcon FontSize="14" Glyph="{StaticResource GlyphPlay}" />
                                </Button>

                                <Button x:Name="RemoveButton" Style="{StaticResource StyleIconButton}">
                                    <FontIcon FontSize="14" Glyph="{StaticResource GlyphClear}" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="DownloadStates">
                                <VisualState x:Name="Queued">
                                    <VisualState.Setters>
                                        <!--<Setter Target="DownloadProgressBar.Visibility" Value="Collapsed" />-->
                                        <Setter Target="StatusAndBytesStatusSeparator.Visibility" Value="Collapsed" />
                                        <Setter Target="BytesStatus.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="Processing">
                                    <VisualState.Setters>
                                        <Setter Target="DownloadProgressBar.IsIndeterminate" Value="True" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="Downloading" />

                                <VisualState x:Name="Converting">
                                    <VisualState.Setters>
                                        <Setter Target="DownloadProgressBar.IsIndeterminate" Value="True" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="Paused">
                                    <VisualState.Setters>
                                        <Setter Target="PauseButton.Visibility" Value="Collapsed" />
                                        <Setter Target="ResumeButton.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="Completed" />

                                <VisualState x:Name="Failed">
                                    <VisualState.Setters>
                                        <!--<Setter Target="DownloadProgressBar.Visibility" Value="Collapsed" />-->
                                        <Setter Target="StatusAndBytesStatusSeparator.Visibility" Value="Collapsed" />
                                        <Setter Target="BytesStatus.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="Cancelled">
                                    <VisualState.Setters>
                                        <!--<Setter Target="DownloadProgressBar.Visibility" Value="Collapsed" />-->
                                        <Setter Target="StatusAndBytesStatusSeparator.Visibility" Value="Collapsed" />
                                        <Setter Target="BytesStatus.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
