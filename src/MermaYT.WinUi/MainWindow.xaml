<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MermaYT.WinUi.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MermaYT.WinUi"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MermaYT.WinUi"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0.0" Color="{StaticResource GradientStartColor}" />
                <GradientStop Offset="0.5" Color="{StaticResource GradientMidColor}" />
                <GradientStop Offset="1.0" Color="{StaticResource GradientEndColor}" />
            </LinearGradientBrush>
        </Grid.Background>

        <Border
            MaxWidth="768"
            Padding="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            BorderThickness="1"
            CornerRadius="32">
            <Border.Background>
                <SolidColorBrush Color="{StaticResource CardBackgroundColor}" />
            </Border.Background>

            <Border.BorderBrush>
                <SolidColorBrush Color="{StaticResource CardBorderColor}" />
            </Border.BorderBrush>

            <StackPanel Spacing="12">
                <TextBlock
                    FontSize="48"
                    FontWeight="Black"
                    LineHeight="56"
                    Text="Download YouTube Video as MP3 or MP4"
                    TextAlignment="Center"
                    TextWrapping="Wrap">
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Offset="0.0" Color="{StaticResource TitleGradientFromColor}" />
                            <GradientStop Offset="0.5" Color="{StaticResource TitleGradientViaColor}" />
                            <GradientStop Offset="1.0" Color="{StaticResource TitleGradientToColor}" />
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>

                <TextBlock
                    Margin="0,20,0,0"
                    FontSize="18"
                    Foreground="{StaticResource SubtitleColor}"
                    LineHeight="28"
                    Text="Paste a YouTube link below and choose your preferred format."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
