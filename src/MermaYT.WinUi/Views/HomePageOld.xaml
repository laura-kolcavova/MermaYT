<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MermaYT.WinUi.Views.HomePageOld"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MermaYT.WinUi.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MermaYT.WinUi.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0.0" Color="{StaticResource GradientStartColor}" />
                <GradientStop Offset="0.5" Color="{StaticResource GradientMidColor}" />
                <GradientStop Offset="1.0" Color="{StaticResource GradientEndColor}" />
            </LinearGradientBrush>
        </Grid.Background>

        <Border
            MaxWidth="768"
            Padding="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            BorderThickness="1"
            CornerRadius="32">
            <Border.Background>
                <SolidColorBrush Color="{StaticResource CardBackgroundColor}" />
            </Border.Background>

            <Border.BorderBrush>
                <SolidColorBrush Color="{StaticResource CardBorderColor}" />
            </Border.BorderBrush>

            <StackPanel Spacing="12">
                <TextBlock
                    Margin="0,0,0,20"
                    FontSize="48"
                    FontWeight="Black"
                    LineHeight="56"
                    Text="Download YouTube Video as MP3 or MP4"
                    TextAlignment="Center"
                    TextWrapping="Wrap">
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Offset="0.0" Color="{StaticResource TitleGradientFromColor}" />
                            <GradientStop Offset="0.5" Color="{StaticResource TitleGradientViaColor}" />
                            <GradientStop Offset="1.0" Color="{StaticResource TitleGradientToColor}" />
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>

                <TextBlock
                    Margin="0,0,0,32"
                    FontSize="18"
                    Foreground="{StaticResource SubtitleColor}"
                    LineHeight="28"
                    Text="Paste a YouTube link below and choose your preferred format."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />

                <Border
                    Padding="20"
                    BorderThickness="1"
                    CornerRadius="24">
                    <Border.Background>
                        <SolidColorBrush Color="{StaticResource InputBlockBackgroundColor}" />
                    </Border.Background>

                    <Border.BorderBrush>
                        <SolidColorBrush Color="{StaticResource InputBlockBorderColor}" />
                    </Border.BorderBrush>

                    <StackPanel Spacing="12">
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource SubtitleColor}"
                            Text="YouTube Video URL" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox
                                Grid.Column="0"
                                Padding="20,16"
                                BorderThickness="1"
                                CornerRadius="16"
                                PlaceholderForeground="{StaticResource InputPlaceholderColor}"
                                PlaceholderText="https://youtube.com/watch?v=...">
                                <TextBox.Resources>
                                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">2</Thickness>
                                    <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource InputBackgroundColor}" />
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource InputBackgroundColor}" />
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource InputBackgroundColor}" />
                                    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="{StaticResource InputBackgroundColor}" />
                                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="{StaticResource InputBorderColor}" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{StaticResource InputBorderColor}" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource InputFocusBorderColor}" />
                                    <SolidColorBrush x:Key="TextControlForeground" Color="{StaticResource SubtitleColor}" />
                                    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="{StaticResource SubtitleColor}" />
                                    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{StaticResource SubtitleColor}" />
                                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{StaticResource InputPlaceholderColor}" />
                                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="{StaticResource InputPlaceholderColor}" />
                                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{StaticResource InputPlaceholderColor}" />
                                </TextBox.Resources>
                            </TextBox>

                            <ComboBox
                                x:Name="OutputProfileComboBox"
                                Grid.Column="1"
                                MinWidth="140"
                                Padding="20,16"
                                VerticalAlignment="Stretch"
                                BorderThickness="1"
                                CornerRadius="16"
                                DisplayMemberPath="Source"
                                FontWeight="SemiBold"
                                SelectedIndex="0">
                                <ComboBox.Resources>
                                    <!--  Prevent border thickness jump on open (fixes shrink)  -->
                                    <Thickness x:Key="ComboBoxBorderThemeThicknessFocused">1</Thickness>
                                    <!--  Closed states  -->
                                    <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource ComboBoxBackgroundColor}" />
                                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{StaticResource ComboBoxBackgroundColor}" />
                                    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{StaticResource ComboBoxBackgroundColor}" />
                                    <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="{StaticResource ComboBoxBackgroundColor}" />
                                    <!--  Open/focused state — fixes the shrink on open  -->
                                    <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="{StaticResource ComboBoxBackgroundColor}" />
                                    <!--  Border  -->
                                    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{StaticResource ComboBoxBorderColor}" />
                                    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="{StaticResource ComboBoxFocusBorderColor}" />
                                    <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="{StaticResource ComboBoxFocusBorderColor}" />
                                    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="{StaticResource ComboBoxFocusBorderColor}" />
                                    <!--  Foreground  -->
                                    <SolidColorBrush x:Key="ComboBoxForeground" Color="{StaticResource ComboBoxForegroundColor}" />
                                    <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="{StaticResource ComboBoxForegroundColor}" />
                                    <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="{StaticResource ComboBoxForegroundColor}" />
                                    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="{StaticResource ComboBoxForegroundColor}" />
                                    <!--  Dropdown  -->
                                    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource ComboBoxDropDownBackgroundColor}" />
                                    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{StaticResource ComboBoxDropDownBorderColor}" />
                                    <!--  Items  -->
                                    <SolidColorBrush x:Key="ComboBoxItemForeground" Color="{StaticResource ComboBoxForegroundColor}" />
                                    <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="{StaticResource ComboBoxForegroundColor}" />
                                    <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="{StaticResource ComboBoxForegroundColor}" />
                                    <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="{StaticResource ComboBoxDropDownItemHoverColor}" />
                                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{StaticResource ComboBoxDropDownItemHoverColor}" />
                                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="{StaticResource ComboBoxDropDownItemHoverColor}" />
                                    <!--  Selection indicator (vertical bar) — override with transparent to hide Windows accent color  -->
                                    <SolidColorBrush x:Key="ComboBoxItemSelectionIndicatorBackground" Color="Transparent" />
                                    <SolidColorBrush x:Key="ComboBoxItemSelectionIndicatorPointerOverBackground" Color="Transparent" />
                                    <SolidColorBrush x:Key="ComboBoxItemSelectionIndicatorPressedBackground" Color="Transparent" />
                                    <SolidColorBrush x:Key="ComboBoxItemSelectionIndicatorDisabledBackground" Color="Transparent" />
                                </ComboBox.Resources>
                                <ComboBoxItem Content="🎵 MP3" />
                                <ComboBoxItem Content="🎬 MP4" />
                            </ComboBox>

                            <controls:HandCursorButton
                                Grid.Column="2"
                                Padding="32,16"
                                Content="Add"
                                CornerRadius="12"
                                FontWeight="Bold">
                                <controls:HandCursorButton.Resources>
                                    <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource ButtonForegroundColor}" />
                                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{StaticResource ButtonForegroundColor}" />
                                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{StaticResource ButtonForegroundColor}" />

                                    <LinearGradientBrush x:Key="ButtonBackground" StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Offset="0.0" Color="{StaticResource ButtonGradientFromColor}" />
                                        <GradientStop Offset="1.0" Color="{StaticResource ButtonGradientToColor}" />
                                    </LinearGradientBrush>

                                    <LinearGradientBrush x:Key="ButtonBackgroundPointerOver" StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Offset="0.0" Color="{StaticResource ButtonGradientPointerOverFromColor}" />
                                        <GradientStop Offset="1.0" Color="{StaticResource ButtonGradientPointerOverToColor}" />
                                    </LinearGradientBrush>

                                    <LinearGradientBrush x:Key="ButtonBackgroundPressed" StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Offset="0.0" Color="{StaticResource ButtonGradientPressedFromColor}" />
                                        <GradientStop Offset="1.0" Color="{StaticResource ButtonGradientPressedToColor}" />
                                    </LinearGradientBrush>
                                </controls:HandCursorButton.Resources>
                            </controls:HandCursorButton>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Page>
