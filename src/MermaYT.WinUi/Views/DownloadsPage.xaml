<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MermaYT.WinUi.Views.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MermaYT.WinUi.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <controls:PageHeader
            Title="Downloads"
            Grid.Row="0"
            Subtitle="Add videos to the queue and download your favorite content." />

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="24" Spacing="10">
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel
                            Grid.Row="0"
                            Margin="0,0,0,20"
                            Spacing="6">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="YouTube URL" />

                            <Grid>
                                <FontIcon
                                    Margin="10,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="16"
                                    Glyph="{StaticResource GlyphLink}"
                                    RenderTransformOrigin="0.5,0.5">
                                    <FontIcon.RenderTransform>
                                        <RotateTransform Angle="-45" />
                                    </FontIcon.RenderTransform>
                                </FontIcon>

                                <TextBox Padding="36,5,10,6" PlaceholderText="https://www.youtube.com/watch?v=..." />
                            </Grid>
                        </StackPanel>

                        <Grid
                            Grid.Row="1"
                            Margin="0,0,0,20"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel
                                Grid.Column="0"
                                Margin="0,0,24,0"
                                Spacing="6">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Output format" />
                                <ComboBox>
                                    <ComboBoxItem Content="MP4 (Video)" />
                                    <ComboBoxItem Content="MP3 (Sound)" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Download to" />

                                <Grid>
                                    <FontIcon
                                        Margin="10,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        Glyph="{StaticResource GlyphFolderHorizontal}" />

                                    <TextBox Padding="36,5,10,6" PlaceholderText="Select download folder..." />
                                </Grid>

                            </StackPanel>

                            <Button
                                Grid.Column="2"
                                MinWidth="130"
                                VerticalAlignment="Bottom"
                                Content="Browse" />
                        </Grid>

                        <Button
                            Grid.Row="2"
                            MinWidth="130"
                            HorizontalAlignment="Right"
                            Content="Add +"
                            Style="{StaticResource AccentButtonStyle}" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
